<xml xmlns="http://www.w3.org/1999/xhtml">
  <!-- Servo sweep on GPIO4 (ESP32). Wire: Servo orange/yellow -> G4, red -> external 5V, brown/black -> GND + common GND with ESP. ESP32 needs ESP32Servo lib, ESP8266 needs Servo lib. -->
  <block type="base_setup_loop" x="30" y="30">
    <statement name="SETUP">
      <block type="board_serial_init"><field name="SPEED">115200</field></block>
    </statement>
    <statement name="LOOP">
      <block type="servo_move">
        <field name="PIN">4</field>
        <value name="DEGREE"><block type="math_number"><field name="NUM">0</field></block></value>
        <next>
          <block type="board_base_delay">
            <value name="DELAY_TIME"><block type="math_number"><field name="NUM">1000</field></block></value>
            <next>
              <block type="servo_move">
                <field name="PIN">4</field>
                <value name="DEGREE"><block type="math_number"><field name="NUM">90</field></block></value>
                <next>
                  <block type="board_base_delay">
                    <value name="DELAY_TIME"><block type="math_number"><field name="NUM">1000</field></block></value>
                    <next>
                      <block type="servo_move">
                        <field name="PIN">4</field>
                        <value name="DEGREE"><block type="math_number"><field name="NUM">180</field></block></value>
                        <next>
                          <block type="board_base_delay">
                            <value name="DELAY_TIME"><block type="math_number"><field name="NUM">1000</field></block></value>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
