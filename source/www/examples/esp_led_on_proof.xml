<xml xmlns="http://www.w3.org/1999/xhtml">
  <!-- PROOF: setup prints HELLO-ESP32 on serial, loop holds GPIO2 HIGH. If upload worked + board booted: LED solid ON + HELLO in monitor. -->
  <block type="base_setup_loop" x="30" y="30">
    <statement name="SETUP">
      <block type="board_serial_init">
        <field name="SPEED">115200</field>
        <next>
          <block type="robosiddhi_esp_serial_print">
            <field name="MODE">LN</field>
            <value name="TEXT">
              <block type="text">
                <field name="TEXT">HELLO-ESP32</field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
    <statement name="LOOP">
      <block type="robosiddhi_led_set">
        <field name="PIN">2</field>
        <field name="STAT">HIGH</field>
      </block>
    </statement>
  </block>
</xml>
