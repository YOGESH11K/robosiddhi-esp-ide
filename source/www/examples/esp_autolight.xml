<xml xmlns="http://www.w3.org/1999/xhtml">
  <!-- Auto light: LDR on ADC (34 ESP32 / A0 ESP8266), LED on 13 -->
  <block type="base_setup_loop" x="30" y="30">
    <statement name="SETUP">
      <block type="board_serial_init"><field name="SPEED">115200</field></block>
    </statement>
    <statement name="LOOP">
      <block type="controls_if">
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">LT</field>
            <value name="A"><block type="robosiddhi_ldr_read"><field name="PIN">34</field></block></value>
            <value name="B"><block type="math_number"><field name="NUM">1500</field></block></value>
          </block>
        </value>
        <statement name="DO0">
          <block type="robosiddhi_led_set"><field name="PIN">13</field><field name="STAT">HIGH</field></block>
        </statement>
        <statement name="ELSE">
          <block type="robosiddhi_led_set"><field name="PIN">13</field><field name="STAT">LOW</field></block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
